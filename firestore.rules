rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Robust Admin check: Handles missing docs and ensures data integrity
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.get('role', 'user') == 'admin' ||
          get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
          get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.get('isAdmin', 'false') == 'true'
        );
    }

    match /Users/{userId} {
      // Strict creation logic from your old rules to prevent privilege escalation
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'user'
        && request.resource.data.get('isAdmin', false) == false;

      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      // Only allow updating own profile, and restrict sensitive fields
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'role', 'isAdmin'])
      );

      allow delete: if isAdmin();

      match /Wishlist/{movieId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    // Rules for Movies collection
    match /Movies/{movieId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /movies/{movieId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Legacy collections (Backwards compatibility)
    match /Bookings/{bookingId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /showtimes/{showtimeId} {
      allow read, write: if signedIn();
    }

    // Rules for Screenings (Shared with Web for atomic seat locking)
    match /screenings/{screeningId} {
      allow read: if true; // Public read for seat maps
      allow create, update: if signedIn(); // Required for atomic transaction locking
      allow delete: if isAdmin();
    }

    // Seat Locking Collection (Shared with Web)
    match /seatLocks/{lockId} {
      // Everyone can read locks to see taken seats
      allow read: if signedIn();

      // Allow users to lock/unlock seats they own.
      // Status 'booked' is permanent, 'locked' is temporary.
      allow write: if isAdmin() || (
        signedIn() && (
          (request.resource == null && resource.data.userId == request.auth.uid) || // Delete own lock
          (request.resource != null && request.resource.data.userId == request.auth.uid) // Create/Update own lock
        )
      );
    }

    // Unified Collection for App & Web Bookings
    match /bookingticket_app_web/{bookingId} {
      // Must be able to read others' bookings to aggregate taken seats in the layout grid
      allow read: if signedIn();

      // Any signed-in user can create a booking document
      allow create: if signedIn();

      // Users can update their own booking status (e.g. to CANCELLED), Admins can update any
      allow update: if signedIn() && (
        isAdmin() ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('uid', '') == request.auth.uid ||
        resource.data.get('userEmail', '') == request.auth.token.email
      );

      allow delete: if isAdmin();
    }
  }
}
