    // Rules for Screenings (Shared with Web for atomic seat locking)
    match /screenings/{screeningId} {
      allow read: if true; // Public read for seat maps
      allow create, update: if signedIn(); // Required for atomic transaction locking
      allow delete: if isAdmin();
    }

    // Seat Locking Collection (Shared with Web)
    match /seatLocks/{lockId} {
      // Everyone can read locks to see taken seats
      allow read: if signedIn();

      // Allow users to lock/unlock seats they own.
      // Status 'booked' is permanent, 'locked' is temporary.
      allow write: if isAdmin() || (
        signedIn() && (
          (request.resource == null && resource.data.userId == request.auth.uid) || // Delete own lock
          (request.resource != null && request.resource.data.userId == request.auth.uid) // Create/Update own lock
        )
      );
    }

    // Unified Collection for App & Web Bookings
