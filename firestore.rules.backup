rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.get('role', 'user') == 'admin' ||
          get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
          get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.get('isAdmin', 'false') == 'true'
        );
    }

    match /Users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.get('role', 'user') == 'user'
        && request.resource.data.get('isAdmin', false) == false;

      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'role', 'isAdmin'])
      );

      allow delete: if isAdmin();

      match /Wishlist/{movieId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /Movies/{movieId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /movies/{movieId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /theatres/{theatreId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /Theatres/{theatreId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cinemas/{cinemaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shows/{showId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /Shows/{showId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /showtimes/{showtimeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /Showtimes/{showtimeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /screenings/{screeningId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /seatLocks/{lockId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.get('userId', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'locked'
      );

      allow update: if isAdmin() || (
        signedIn()
        && (
          (
            resource.data.get('userId', '') == request.auth.uid
            && resource.data.get('status', '') == 'locked'
            && request.resource.data.get('status', '') == 'booked'
            && request.resource.data.get('userId', '') == request.auth.uid
          )
          ||
          (
            resource.data.get('userId', '') == request.auth.uid
            && resource.data.get('status', '') == 'locked'
            && request.resource.data.get('status', '') == 'locked'
            && request.resource.data.get('userId', '') == request.auth.uid
          )
          ||
          (
            resource.data.get('userId', '') == request.auth.uid
            && resource.data.get('status', '') == 'booked'
            && request.resource.data.get('status', '') == 'cancelled'
            && request.resource.data.get('userId', '') == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt','cancellationReason'])
          )
          ||
          (
            resource.data.get('status', '') == 'cancelled'
            && request.resource.data.get('status', '') == 'locked'
            && request.resource.data.get('userId', '') == request.auth.uid
          )
        )
      );

      allow delete: if isAdmin() || (
        signedIn()
        && resource.data.get('userId', '') == request.auth.uid
        && resource.data.get('status', '') == 'locked'
      );
    }

    match /bookingticket_app_web/{bookingId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (
        isAdmin() ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('uid', '') == request.auth.uid ||
        resource.data.get('userEmail', '') == request.auth.token.email
      );
      allow delete: if isAdmin();
    }

    match /wishlist/{userId}/movies/{movieId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
      allow read: if isAdmin() || owns(resource.data);

      allow create: if signedIn()
        && (
          request.resource.data.get('userId', '') == request.auth.uid
          || request.resource.data.get('uid', '') == request.auth.uid
          || request.resource.data.get('userEmail', '') == request.auth.token.email
        );

      // Admin manages all bookings. Users may only cancel their own ticket,
      // and cannot alter ownership, seats, amount, show, or payment fields.
      allow update: if isAdmin() || (
        owns(resource.data)
        && request.resource.data.get('status', '') == 'CANCELLED'
        && resource.data.get('status', '') != 'CANCELLED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt','cancellationReason'])
      );

      allow delete: if isAdmin();
    }

    // ---------------- Legacy compatibility ----------------
    match /Bookings/{bookingId} {
      allow read: if isAdmin() || owns(resource.data);
      allow create: if signedIn() && owns(request.resource.data);
      allow update: if isAdmin() || (
        owns(resource.data)
        && request.resource.data.get('status', '') == 'CANCELLED'
      );
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isAdmin() || owns(resource.data);
      allow create: if signedIn() && owns(request.resource.data);
      allow update: if isAdmin() || (
        owns(resource.data)
        && request.resource.data.get('status', '') == 'CANCELLED'
      );
      allow delete: if isAdmin();
    }

    // ---------------- Payments ----------------
    match /Payments/{paymentId} {
      allow read: if isAdmin() || owns(resource.data);
      allow create: if isAdmin() || owns(request.resource.data);
      allow update, delete: if isAdmin();
    }
    match /payments/{paymentId} {
      allow read: if isAdmin() || owns(resource.data);
      allow create: if isAdmin() || owns(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
